generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The app runs on Neon's pooled connection (serverless opens a lot of short
  // connections). Migrations can't go through the pooler — PgBouncer in
  // transaction mode can't run them — so `prisma migrate deploy` uses the
  // direct connection instead. Locally both can point at the same database.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  cashUsd          Float   @default(100000)
  subscribed       Boolean @default(false)
  paddleCustomerId String? @unique

  positions      PaperPosition[]
  trackedWallets TrackedWallet[]
  copyFollows    CopyFollow[]
  mirroredTrades MirroredTrade[]
  analyses       AnalysisRecord[]
}

model PaperPosition {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketQuestion      String
  platform            String
  side                String
  entryPrice          Float
  sizeUsd             Float
  openedAt            DateTime  @default(now())
  status              String    @default("open")
  closedAt            DateTime?
  exitPrice           Float?
  source              String?
  sourceTraderAddress String?

  @@index([userId])
}

model TrackedWallet {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress String
  name          String?
  trackedAt     DateTime @default(now())

  @@unique([userId, walletAddress])
}

model CopyFollow {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress            String
  name                     String?
  allocationUsd            Float
  followedAt               DateTime @default(now())
  lastSeenTradeTimestampMs Float    @default(0)

  @@unique([userId, walletAddress])
}

model MirroredTrade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traderLabel String
  question    String
  outcome     String?
  price       Float
  sizeUsd     Float
  at          DateTime @default(now())

  @@index([userId])
}

model AnalysisRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One AI-curated pick, cached so every subscriber sees the same weekly set
/// instead of re-running (and re-paying for) analysis on each page view.
model HandpickedPick {
  id         String   @id @default(cuid())
  weekOf     DateTime
  rank       Int
  platform   String
  marketId   String
  question   String
  url        String?
  /// The side the AI backs, and how sure it is.
  side       String
  confidence Float
  /// Market-implied probability for that side at curation time, and the gap
  /// between the AI's confidence and it. Positive edge = AI thinks the market
  /// is underpricing this outcome.
  marketPct  Float
  edge       Float
  volumeUsd  Float
  /// Full AnalysisResult so the card can expand without another API call.
  analysis   Json
  createdAt  DateTime @default(now())

  @@unique([weekOf, platform, marketId])
  @@index([weekOf, rank])
}
