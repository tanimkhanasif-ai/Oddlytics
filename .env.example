# --- Anthropic (AI Analyzer + AI Coach) ------------------------------------
# Leave unset to run on mocked AI responses (the default). Set this to switch
# both the Analyzer and Coach over to real Claude calls automatically — no
# code changes needed.
ANTHROPIC_API_KEY=

# Optional: override the default models used for each feature.
ANALYSIS_MODEL=claude-sonnet-5
COACH_MODEL=claude-sonnet-5

# --- Stripe (Handpicked Bets paywall) ---------------------------------------
# Leave unset to run the mocked/test-mode checkout flow (the default). Set
# all three to switch to real Stripe Checkout automatically — no code
# changes needed.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Auth + database (required) ---------------------------------------------
# Accounts, Paper Trading, subscriptions, tracked wallets, Copy Trading, and
# analysis history all live in Postgres now — the app won't run without these.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Postgres connection string (e.g. from Neon): postgresql://user:pass@host/db
# Note: the Prisma CLI reads `.env` specifically (not `.env.local`), so also
# put DATABASE_URL in a `.env` file for `prisma migrate` to pick it up.
DATABASE_URL=
