# --- Anthropic (AI Analyzer + Handpicked Bets curation) --------------------
# Leave unset to run on mocked AI responses (the default). Set this to switch
# to real Claude calls automatically — no code changes needed.
ANTHROPIC_API_KEY=

# Optional: override the default model.
ANALYSIS_MODEL=claude-sonnet-5

# --- Whop (Handpicked Bets + Pricing paywall) -------------------------------
# Leave unset to run the mocked/test-mode checkout flow (the default). Whop is
# a Merchant of Record — it collects and remits sales tax/VAT worldwide for
# you, and supports sellers based in countries Stripe doesn't (e.g.
# Bangladesh). The server creates a checkout configuration for WHOP_PLAN_ID
# and redirects the buyer to Whop's own generated purchase_url (a full-page
# redirect, not an embed — see README for why). Set WHOP_API_KEY + WHOP_PLAN_ID
# + WHOP_WEBHOOK_SECRET to switch checkout over to the real Whop flow
# automatically — no code changes needed.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_ID=

# --- Google sign-in (optional) ----------------------------------------------
# Leave unset to keep "Continue with Google" showing "not connected yet" (the
# default — email/password still works fully). Set both to switch it on
# automatically — no code changes needed. Get these from console.cloud.google.com:
# APIs & Services -> Credentials -> Create Credentials -> OAuth client ID ->
# Web application. Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google       (local dev)
#   https://<your-production-domain>/api/auth/callback/google  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth + database (required) ---------------------------------------------
# Accounts, Paper Trading, subscriptions, tracked wallets, Copy Trading, and
# analysis history all live in Postgres now — the app won't run without these.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Neon gives you TWO connection strings for the same database. Both are needed:
#   DATABASE_URL -> the POOLED one (hostname contains "-pooler"). The app uses
#                   this; serverless opens many short connections.
#   DIRECT_URL   -> the DIRECT one (no "-pooler"). Migrations use this, because
#                   they can't run through the connection pooler.
# Running plain local Postgres? Point both at the same string.
# Note: the Prisma CLI reads `.env` specifically (not `.env.local`), so put both
# in a `.env` file too for `prisma migrate` to pick them up.
DATABASE_URL=
DIRECT_URL=

# --- Weekly Handpicked Bets curation ----------------------------------------
# The Monday 06:00 UTC Vercel Cron job at /api/cron/handpicks re-scans live
# markets and republishes the week's 10 picks. Set this to any long random
# string (openssl rand -hex 32) and add the same value in Vercel — the endpoint
# stays closed (501) until it's set, so nobody can trigger paid analysis runs.
CRON_SECRET=
